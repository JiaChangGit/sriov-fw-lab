diff --git a/drivers/pci/iov.c b/drivers/pci/iov.c
--- a/drivers/pci/iov.c
+++ b/drivers/pci/iov.c
@@ -13,6 +13,8 @@
 #include <linux/string.h>
 #include <linux/delay.h>
 #include "pci.h"
+#include <linux/debugfs.h>
+#include <linux/init.h>
 
 #define VIRTFN_ID_LEN	17	/* "virtfn%u\0" for 2^32 - 1 */
 
@@ -19,3 +21,31 @@
+/* 僅測試 kernel 使用；限定本實驗 PF，一次注入後立即解除。 */
+static u32 toy_sriov_fail_nth;
+
+static int toy_sriov_fail_get(void *data, u64 *value)
+{
+	*value = READ_ONCE(toy_sriov_fail_nth);
+	return 0;
+}
+
+static int toy_sriov_fail_set(void *data, u64 value)
+{
+	if (value > 8)
+		return -EINVAL;
+	WRITE_ONCE(toy_sriov_fail_nth, value);
+	return 0;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(toy_sriov_fail_fops, toy_sriov_fail_get,
+			 toy_sriov_fail_set, "%llu\n");
+
+static int __init toy_sriov_fail_init(void)
+{
+	debugfs_create_file("toy_sriov_fail_nth", 0600, NULL, NULL,
+			    &toy_sriov_fail_fops);
+	return 0;
+}
+late_initcall(toy_sriov_fail_init);
+
 int pci_iov_virtfn_bus(struct pci_dev *dev, int vf_id)
 {
 	if (!dev->is_physfn)
@@ -499,6 +530,14 @@ static int sriov_add_vfs(struct pci_dev *dev, u16 num_vfs)
 		return 0;
 
 	for (i = 0; i < num_vfs; i++) {
+		if (dev->vendor == 0x1234 && dev->device == 0xe001 &&
+		    READ_ONCE(toy_sriov_fail_nth) == i + 1 &&
+		    cmpxchg(&toy_sriov_fail_nth, i + 1, 0) == i + 1) {
+			pci_info(dev, "TOY_PCI_ENUM_FAIL nth=%u added=%u\n", i + 1, i);
+			rc = -ENOMEM;
+			goto failed;
+		}
+		/* 保留上游的 VF 建立及反向移除路徑。 */
 		rc = pci_iov_add_virtfn(dev, i);
 		if (rc)
 			goto failed;
